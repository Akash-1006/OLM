# =====================================================================
# OLM SaaS — Environment Variables
# Copy to .env and fill in your values.
# Never commit .env to git.
# =====================================================================

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_TOKEN=your_platform_bot_token
WEBHOOK_URL=https://your-domain.com

# ── Database ─────────────────────────────────────────────────
# SQLite (dev):   sqlite:///./leads.db
# PostgreSQL:     postgresql://user:pass@localhost:5432/olm
DATABASE_URL=sqlite:///./leads.db

# ── Master admin ───────────────────────────────────────────────
# Set a strong password here — this is your SaaS operator key
MASTER_ADMIN_PASSWORD=change_me_strong_password

# ── Default tenant (backwards compat for existing single-tenant deploy) ─
# Used by migrations/add_tenant_id.py to create tenant id=1
DEFAULT_TENANT_NAME=Default
DEFAULT_TENANT_SLUG=default
ADMIN_PASSWORD=change_me_tenant_admin     # tenant admin password
MINIAPP_ACCESS_KEY=                       # miniapp key (leave blank for open access)
MINIAPP_BASE_URL=https://your-domain.com
BRAND_NAME=OLM

# ── Daily digest ──────────────────────────────────────────────
# Get your chat_id by messaging @userinfobot on Telegram
DIGEST_OWNER_CHAT_ID=your_telegram_chat_id
DIGEST_TIME_IST=20:00

# ── Quote PDF template ────────────────────────────────────────────
QUOTE_TEMPLATE_DIR=static
